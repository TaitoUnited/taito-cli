---
import { getCollection, render } from 'astro:content';
import CollectionPage from '../../layouts/CollectionPage.astro';
import { buildMenu, getEntryTitle } from '../../utils/buildMenu';

export async function getStaticPaths() {
  const entries = await getCollection('docs', (entry) => entry.id !== 'README');
  const menu = await buildMenu('docs', '/docs');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, menu },
  }));
}

const { entry, menu } = Astro.props;
const { Content, headings } = await render(entry);
---

<CollectionPage
  title={getEntryTitle(headings) ?? 'Documentation'}
  sidebarTitle="DOCUMENTATION"
  menu={menu}
  currentId={entry.id}
  editPath={`/docs/${entry.id}`}
>
  <Content />
</CollectionPage>
