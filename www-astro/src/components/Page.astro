---
import Navigation from './Navigation.astro';
import { theme } from '../theme';

interface Props {
  isHome?: boolean;
  // Skips the .main/.content wrapper (sidebar layout + markdown-content
  // styling) for pages, like the homepage, with a completely different
  // shell - only the outer wrapper + <Navigation> are actually shared.
  bare?: boolean;
}

const { isHome = false, bare = false } = Astro.props;
const hasMenu = Astro.slots.has('menu');
---

<div class="wrapper">
  {bare ? (
    <slot />
  ) : (
    <div class="main" class:list={{ 'has-menu': hasMenu }}>
      {hasMenu && (
        <div class="menu">
          <slot name="menu" />
        </div>
      )}
      <div class="content">
        <slot />
      </div>
    </div>
  )}

  <Navigation isHome={isHome} />
</div>

<style
  define:vars={{
    linkColor: theme.primary[800],
    linkBg: theme.primary[100],
    linkHoverBg: theme.primary[200],
    hrColor: theme.grey[300],
    blockquoteBorder: theme.primary[500],
    blockquoteColor: theme.primary[700],
  }}
>
  .wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .main {
    display: flex;
    flex-direction: row;
    width: 100%;
    overflow-x: hidden;
    margin-top: 50px;
    padding-left: 0px;
  }

  .main.has-menu {
    padding-left: 320px;
  }

  @media (max-width: 820px) {
    .main {
      padding-left: 0px;
      margin-top: 54px;
    }
  }

  .menu {
    position: fixed;
    top: 50px;
    left: 0px;
    height: calc(100vh - 50px);
    overflow-y: auto;
  }

  .content {
    flex: 1;
    width: 100%;
    padding: 16px;
    max-width: 900px;
    margin: 0px auto;
  }

  .content :global(a:not(.autolink-a)) {
    color: var(--linkColor);
    background-color: var(--linkBg);
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    text-decoration: none;
  }

  .content :global(a:not(.autolink-a):hover) {
    background-color: var(--linkHoverBg);
  }

  .content :global(hr) {
    margin-top: 24px;
    margin-bottom: 24px;
    border: none;
    height: 1px;
    background-color: var(--hrColor);
  }

  .content :global(ul) {
    list-style: disc;
    padding-left: 24px;
  }

  .content :global(ul > li) {
    margin-top: 8px;
  }

  .content :global(blockquote) {
    margin: 0;
    padding: 8px 16px;
    background-color: var(--linkBg);
    border-left: 8px solid var(--blockquoteBorder);
    color: var(--blockquoteColor);
    border-radius: 2px;
  }
</style>
