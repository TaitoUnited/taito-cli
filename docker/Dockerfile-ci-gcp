FROM ghcr.io/taitounited/taito-cli-deps:ci-gcp
LABEL fi.taitounited.taito-cli="true"

USER root

RUN apt-get update && apt-get install -y --no-install-recommends google-cloud-cli-log-streaming \
    && rm -rf /var/lib/apt/lists/*

COPY . /taito-cli
WORKDIR /taito-cli
RUN ln -s /taito-cli/src/execute-command /usr/local/bin/taito
# RUN npm run verify

# NOTE: Using root user as docker.sock access is often required on CI/CD
ENV taito_mode ci
ENTRYPOINT ["taito"]
