#!/bin/bash -e
# shellcheck source=../upcloud/lib/all.bash
. "${taito_plugin_path:?}/../upcloud/lib/all.bash"
# shellcheck source=lib/all.bash
. "${taito_plugin_path:?}/lib/all.bash"

( [[ ${kubernetes_name:-} ]] && \
  [ -f terraform/kubeconfig.yaml ] && \
  taito::confirm "Move terraform/kubeconfig.yaml to ~/.kube/config"
) || taito::skip_to_next "${@}"

mv -f terraform/kubeconfig.yaml ~/.kube/config

taito::call_next "${@}"
