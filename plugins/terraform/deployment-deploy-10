#!/bin/bash -e
# shellcheck source=lib/all.bash
. "${taito_plugin_path:?}/lib/all.bash"

# Cloud provider
if [[ ! ${taito_deployment_platforms:-} ]] || \
   [[ ${taito_deployment_platforms} == *"terraform"* ]]; then
  image="${1:-taito_target_image}"

  # Determine image
  # TODO: this is a quick hack (same on helm plugin)
  if [[ ${taito_mode:-} == "ci" ]] && \
     [[ ${ci_exec_build:-} == "true" ]] && \
     [[ ${image} != *"-untested" ]] && \
     [[ ! -f ./taitoflag_images_exist ]]; then
    image="${image}-untested"
  elif [[ ${image} == "--dry-run" ]]; then
    image="DRY_RUN"
  elif [[ -z "${image}" ]]; then
    # Image not given as param and using 'latest' causes problems
    echo "ERROR: image tag not given"
    exit 1
  fi
  
  taito_build_image_tag="${image}" \
    terraform::run apply "${taito_provider:-}-deploy" "${taito_target_env:-$taito_env}" || (
      if [[ ${taito_mode:-} == "ci" ]]; then
        taito::print_note_start
        echo
        echo "----------------------------------------------------------------------------"
        echo "Your CI/CD might not have necessary rights to execute all the changes that"
        echo "were required this time. Try to execute the changes manually by running the"
        echo "following command, and then retry the CI/CD build."
        echo
        echo "taito deployment deploy:${taito_target_env} ${1:-taito_target_image}"
        echo
        echo "----------------------------------------------------------------------------"
        echo
        taito::print_note_end
      fi
      exit 1
    )
fi

# Modules with deploy prefix
terraform::run_all_by_prefix deploy apply "${taito_target_env:-$taito_env}"

taito::call_next "${@}"
