---
import { getEntry, render } from 'astro:content';
import StandalonePage from '../../layouts/StandalonePage.astro';

const entry = await getEntry('tutorial', 'README');
if (!entry) throw new Error('docs/tutorial/README.md not found');
const { Content } = await render(entry);
---

<StandalonePage title="Tutorial" editPath="/tutorial/README">
  <Content />
</StandalonePage>
